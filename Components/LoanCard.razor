@using FlipperSimLib.Models
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FlipperSim.Resources.Localization> Localizer

<RadzenCard Variant="Variant.Text" class="rz-w-100">
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.5rem" Class="rz-w-100" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
        <RadzenText TextStyle="TextStyle.Body1">
            @($"{Loan.LoanAmount/1000:N0}k PLN @ {Loan.InterestRate*100:N2} %")
        </RadzenText>
        <RadzenButton ButtonStyle="ButtonStyle.Success" Disabled="@(AvailableFunding < Loan.LoanAmount)" Click="PayOff">@Localizer["PayOff"]</RadzenButton>
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter] public required Loan Loan { get; init; }
    [Parameter] public required decimal AvailableFunding { get; init; }
    [Parameter] public EventCallback<string> OnClickCallback { get; init; }

    private async Task PayOff()
    {
        await OnClickCallback.InvokeAsync(Loan.LoanId);
    }
}