@page "/"
@using FlipperSim.Components
@using FlipperSimLib
@using FlipperSimLib.Models
@using System.Drawing
@using System.Diagnostics
@using Radzen.Blazor
@using Radzen.Blazor.Rendering
@inject DialogService DialogService

<PageTitle>FlipperSim</PageTitle>
<RadzenRow>
    <RadzenColumn SizeSM=12 SizeMD="8">
        <RadzenStack AlignItems="AlignItems.Center" Orientation="Radzen.Orientation.Vertical">
            <RadzenChart class="rz-w-100">
                <RadzenChartTooltipOptions Shared="@false" />
                <RadzenLineSeries Data="@_chartValues" CategoryProperty="Index" Title=" " ValueProperty="Value" LineType="LineType.Solid" Stroke="rgb(100,125,100)">
                    <RadzenMarkers Visible="@false" />
                    <RadzenSeriesDataLabels Visible="@false" />
                </RadzenLineSeries>
                <RadzenCategoryAxis/>
                <RadzenValueAxis Formatter="@FormatAsCurrency">
                    <RadzenGridLines Visible="true" />
                    <RadzenAxisTitle Text="PLN" />
                </RadzenValueAxis>
            </RadzenChart>
            <RadzenRow Gap="0.5rem" class="rz-w-100">
                <RadzenColumn SizeMD="6" SizeLG="6" SizeSM="12">
                    <RadzenStack AlignItems="AlignItems.Center" class="rz-w-100 rz-p-4 rz-border rz-border-radius-4 rz-border-color-primary-dark">
                        <RadzenText TextStyle="TextStyle.H5">
                            <i class="bi bi-wallet2"></i> Your Flipper Account
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption">Current Balance</RadzenText>
                        <RadzenText TextStyle="TextStyle.H4" class="@(MarketSim.FlipperAccount.AccountBalance >= 0 ? "rz-color-success" : "rz-color-danger")">
                            @($"{MarketSim.FlipperAccount.AccountBalance:N2} PLN")
                        </RadzenText>

                        <!-- Quick Actions -->
                        <RadzenButton ButtonStyle="ButtonStyle.Warning" Style="min-width: 12rem" Disabled="@(LoansTotal > 700_000)" ButtonSize="ButtonSize.Small" Click="async () => await TakeLoan(50_000)">
                            <i class="bi bi-cash-coin"></i> 50k Loan
                        </RadzenButton>

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Style="min-width: 12rem" Disabled="@(LoansTotal > 650_000)" Click="async () => await TakeLoan(100_000)">
                            <i class="bi bi-cash-stack"></i> 100k Loan
                        </RadzenButton>

                        <!-- Account Summary -->
                        <div class="fw-bold text-danger">@($"Loans for {LoansTotal:N0} PLN")</div>

                        @if (MarketSim.FlipperAccount.Loans.Any())
                        {
                            <RadzenButton @ref=_loansButton ButtonStyle="ButtonStyle.Info" Click="@(args => _loansPopup.ToggleAsync(_loansButton.Element))" Text="Show Loans"/>
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn SizeMD="6" SizeLG="6" SizeSM="12">
                    <RadzenStack AlignItems="AlignItems.Center" class="rz-w-100">
                        @if (MarketSim.FlipperAccount.Investments.Any())
                        {
                            <RadzenText TextStyle="TextStyle.H5">
                                <i class="bi bi-house-fill"></i> @($"Your Investments ({MarketSim.FlipperAccount.Investments.Sum(i => i.GetCurrentPrice()):N0} PLN)")
                            </RadzenText>
                            @foreach (var inv in MarketSim.FlipperAccount.Investments)
                            {
                                <InvestmentCard Model="inv" MarketSim="MarketSim"
                                                OnClickCallback="@(EventCallback.Factory.Create<string>(this, SellInvestment))"
                                                OnUpgradeClickCallback="@(EventCallback.Factory.Create<string>(this, UpgradeInvestment))" />
                            }
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.H5">
                                <i class="bi bi-house" style="font-size: 3rem;"></i> No Investments Yet
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" class="text-center">
                                Start buying properties to see them here!
                            </RadzenText>
                        }
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenColumn>
    <RadzenColumn SizeSM="12" SizeMD="4" class="text-end rz-p-3">
        <RadzenStack AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.H5">Active Offers (@CurrentOffers.Count)</RadzenText>
            <RadzenRow>
                @foreach (var off in CurrentOffers)
                {
                    <RadzenColumn Size="12" SizeXL="6">
                        <OfferCard Offer="off" AvailableFunding="MarketSim.FlipperAccount.AccountBalance"
                                   OnDeleteClickCallback="@(EventCallback.Factory.Create<RealEstateOffer>(this, DeleteOffer))"
                                   OnBuyClickCallback="@(EventCallback.Factory.Create<RealEstateOffer>(this, BuyOffer))" />
                    </RadzenColumn>
                }
            </RadzenRow>
        </RadzenStack>
    </RadzenColumn>
</RadzenRow>

<Popup @ref=_loansPopup Lazy=true class="my-popup">
    <RadzenText TextStyle="TextStyle.Body1" class="rz-p-4 rz-w-100 rz-text-align-center">
        <i class="bi bi-cash-stack"></i> Your Loans
    </RadzenText>
    @if (@MarketSim.FlipperAccount.Loans.Count() == 0)
    {
        <RadzenText TextStyle="TextStyle.Body1" class="rz-p-4 rz-w-100 rz-text-align-center">
            No active loans - good job!
        </RadzenText>
    }
    else
    {
        <RadzenDataList @ref=_dataList AllowVirtualization=true Data="@MarketSim.FlipperAccount.Loans" Style="flex: 1; --rz-datalist-padding: 0.1rem 0; --rz-datalist-item-margin-inline: 0; overflow:auto;">
            <Template Context="_loan">
                <LoanCard Loan="_loan" AvailableFunding="@MarketSim.FlipperAccount.AccountBalance" OnClickCallback="@(EventCallback.Factory.Create<string>(this, PayOffLoan))" />
            </Template>
        </RadzenDataList>
    }
</Popup>

@code {

    public record ChartDataItem(int Index, double? Value);

    private bool IsLoading = false;
    private RadzenDialog dialog = default!;
    private bool _unchartedTerritory = true;
    private ICollection<ChartDataItem> _chartValues = new List<ChartDataItem>();
    private readonly RealEstateMarketSimulation MarketSim = new (new MarketPriceProvider(), null);
    private ICollection<RealEstateOffer> CurrentOffers = [];
    private decimal LoansTotal => MarketSim.FlipperAccount.Loans.Sum(l => l.LoanAmount);
    private Timer? _refreshTimer = default;
    private long _startIndex = 0;
    private bool _isGameOver = false;
    private string _gameOverReason = string.Empty;
    private readonly Stopwatch _stopWatch = new();
    private Popup _loansPopup = default!;
    private RadzenButton _loansButton = default!;
    private RadzenDataList<Loan> _dataList = default!;
    private Loan? _loan = default;

    string? FormatAsCurrency(object value)
    {
        return ((double?)value)?.ToString("N2");
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (_refreshTimer is null)
        {
            _refreshTimer = new Timer(async s => await RefreshRealEstateMarketAsync(s), null, 0, Timeout.Infinite);
        }
    }

    protected async Task RefreshRealEstateMarketAsync(object? state)
    {
        _stopWatch.Restart();

        if (_isGameOver)
        {
            MarketSim.ResetAccount();
            await DialogService.Alert(_gameOverReason ?? "It's over, sorry.", "GAME OVER :-(", new AlertOptions { OkButtonText = "OK, thanks!" });
            _isGameOver = false;
        }

        if (MarketSim.IsFreshGame)
        {
            await DialogService.OpenAsync<WelcomeDialog>( 
                $"Welcome, Flipper!",
               new Dictionary<string, object>(),
               new DialogOptions()
               {
                   Resizable = false,
                   Draggable = false,
                   CloseDialogOnEsc = false,
                   CloseDialogOnOverlayClick = false,
               });
        }

        CurrentOffers = MarketSim.GetUpdatedRealEstateOffers(10).OrderBy(o => o.CreatedAt).ToList();

        _chartValues.Add(new(_chartValues.LastOrDefault()?.Index+1 ?? 1, (double)MarketSim.GetMarketPricePerSqMeter(50.0m, false)));
        if (_chartValues.Count > 100)
        {
            _chartValues = _chartValues.Skip(1).ToList();
            ++_startIndex;
        }

        (_isGameOver, _gameOverReason) = MarketSim.CheckIfGameIsOver();
        StateHasChanged();
        _stopWatch.Stop();
        var dt = Math.Max(0, 995 - _stopWatch.ElapsedMilliseconds);
        _refreshTimer?.Change(dt, Timeout.Infinite);
    }


    private Task DeleteOffer(RealEstateOffer offer)
    {
        this.MarketSim.DeleteOffer(offer.PropertyRefId);
        this.CurrentOffers.Remove(offer);

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task BuyOffer(RealEstateOffer offer)
    {
        try
        {
            this.MarketSim.BuyOffer(offer.PropertyRefId);
            this.CurrentOffers.Remove(offer);
            StateHasChanged();

        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error buying offer {offer.PropertyRefId}: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    private Task SellInvestment(string refId)
    {
        try
        {
            this.MarketSim.SellInvestment(refId);
            StateHasChanged();
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error selling investment {refId}: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    private Task TakeLoan(decimal amount)
    {
        try
        {
            this.MarketSim.FlipperAccount.AddLoan(
                new Loan
                {
                    InterestRate = this.MarketSim.GetInterestRate(),
                    LoanAmount = amount,
                    PaymentFrequency = 5,
                    LoanId = Guid.NewGuid().ToString()
                });

            StateHasChanged();
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error taking loan of {amount}: {ex.Message}");
        }
        return Task.CompletedTask;

    }

    private Task PayOffLoan(string loanId)
    {
        try
        {
            this.MarketSim.FlipperAccount.PayOffLoan(loanId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error paying off loan: {loanId}: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    private Task UpgradeInvestment(string refId)
    {
        if(this.MarketSim.UpgradeInvestment(refId))
        {
            StateHasChanged();
        }

        return Task.CompletedTask;
    }
}
