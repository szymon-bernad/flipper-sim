@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FlipperSim.Resources.Localization> Localizer

<div class="pause-overlay">
    <div class="pause-content">
        <i class="bi bi-pause-circle-fill" style="font-size: 4rem; color: rgba(100,125,100,1);"></i>
        <RadzenText TextStyle="TextStyle.H3" class="rz-mt-4">@Localizer["GamePaused"]</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary">@Localizer["GameSaved"]</RadzenText>
        <RadzenButton ButtonStyle="ButtonStyle.Success" Style="min-width: 14rem; margin-top: 1.5rem;" Click="OnResumeClicked">
            <i class="bi bi-play-fill"></i> @Localizer["ResumeGame"]
        </RadzenButton>
    </div>
</div>

<style>
    .pause-overlay {
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pause-content {
        text-align: center;
        background: white;
        border-radius: 1rem;
        padding: 3rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }
</style>

@code {
    [Parameter] public EventCallback OnResumeClicked { get; set; }
}
