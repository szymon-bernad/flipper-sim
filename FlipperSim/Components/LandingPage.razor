@using FlipperSim.Services
@using Microsoft.Extensions.Localization
@using System.Globalization
@inject IStringLocalizer<FlipperSim.Resources.Localization> Localizer
@inject CultureService CultureService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<div class="landing-container">
    <div class="landing-content">
        <div class="landing-header">
            <i class="bi bi-house-heart-fill landing-icon"></i>
            <h1 class="landing-title">FlipperSim</h1>
            <p class="landing-subtitle">Real Estate Investment Simulator</p>
        </div>

        <div class="language-selection">
            <h2 class="selection-title">Select Your Language / Wybierz język</h2>

            <div class="language-cards">
                @foreach (var culture in CultureService.GetSupportedCultures())
                {
                    <div class="language-card" @onclick="() => SelectLanguage(culture.Name)">
                        <div class="language-name">
                            @culture.NativeName
                        </div>
                        <div class="language-code">
                            @culture.TwoLetterISOLanguageName.ToUpper()
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .landing-container {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .landing-content {
        max-width: 800px;
        width: 100%;
        text-align: center;
    }

    .landing-header {
        margin-bottom: 3rem;
    }

    .landing-icon {
        font-size: 5rem;
        color: rgba(100,125,100,1);
        margin-bottom: 1rem;
    }

    .landing-title {
        font-size: 3.5rem;
        font-weight: bold;
        color: rgba(100,125,100,1);
        margin-bottom: 0.5rem;
    }

    .landing-subtitle {
        font-size: 1.25rem;
        color: #666;
        font-weight: 300;
    }

    .language-selection {
        background: white;
        border-radius: 1rem;
        padding: 2.5rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }

    .selection-title {
        font-size: 1.75rem;
        color: #333;
        margin-bottom: 2rem;
        font-weight: 600;
    }

    .language-cards {
        display: grid;
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .language-card {
        background: rgba(100,125,100,0.5) 0%;
        border: 2px solid rgba(100,125,100,0.2);
        border-radius: 1rem;
        padding: 2rem 1.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

        .language-card:hover {
            transform: translateY(-5px);
            border-color: rgba(100,125,100,0.8);
            box-shadow: 0 10px 30px rgba(100,125,100,0.2);
            background: rgba(81,168,139,0.25);
        }

    .language-flag {
        font-size: 4rem;
        line-height: 1;
    }

    .language-name {
        font-size: 1.25rem;
        font-weight: 600;
        color: #333;
        text-transform: capitalize;
    }

    .language-code {
        font-size: 0.875rem;
        color: #666;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    @@media (max-width: 768px) {
        .landing-title {
            font-size: 2.5rem;
        }

        .landing-icon {
            font-size: 3.5rem;
        }

        .language-selection {
            padding: 1.5rem;
        }

        .selection-title {
            font-size: 1.5rem;
        }

        .language-cards {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .language-card {
            padding: 1.5rem 1rem;
        }
    }
</style>

@code {
    private async Task SelectLanguage(string cultureName)
    {
        var cultureInfo = new CultureInfo(cultureName);
        await JS.InvokeVoidAsync("blazorCulture.set", cultureInfo.Name);
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}
