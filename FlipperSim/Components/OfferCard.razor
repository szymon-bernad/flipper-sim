@using FlipperSimLib
@using FlipperSimLib.Models
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FlipperSim.Resources.Localization> Localizer

<RadzenCard Variant="Variant.Outlined" Class="rz-p-0 rz-w-100" Style="min-width: 10rem;" Gap="0.5rem">
    <RadzenStack Class="@($"{BgClass} rz-w-100 rz-p-2")" Gap="0" AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.H6" >
            @(OfferHeader)
            </RadzenText>
        <RadzenStack Style="min-height: 5rem" AlignItems="AlignItems.Center">
                @if (Offer.IsPremium)
                {
                    <RadzenBadge class="rz-w-70">Premium</RadzenBadge>
                }
                else
                {
                    <span />
                }
            <RadzenText TextStyle="TextStyle.Caption">@Localizer["CurrentPrice"] /m2:</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">@($"{Offer.OfferPricePerSqMeter:N2} PLN")</RadzenText>

            </RadzenStack>
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenButton Size="Radzen.ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Disabled="@(AvailableFunding < Offer.TotalPrice())" Click="Buy">@Localizer["BuyThat"]</RadzenButton>
            <RadzenButton Size="Radzen.ButtonSize.Small" ButtonStyle="ButtonStyle.Warning" Click="Delete">@Localizer["NopeThx"]</RadzenButton>
        </RadzenStack>
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter] public required RealEstateOffer Offer { get; init; }
    [Parameter] public required decimal AvailableFunding { get; init; }
    [Parameter] public EventCallback<RealEstateOffer> OnDeleteClickCallback { get; init; }
    [Parameter] public EventCallback<RealEstateOffer> OnBuyClickCallback { get; init; }

    private string BgClass => AvailableFunding > Offer.TotalPrice() ? "rz-p-0 rz-background-color-success-light" : "rz-p-0 rz-background-color-secondary";

    private string OfferHeader => $"[{Offer.UsableAreaSqMeters}m2] @ {Math.Round(Offer.TotalPrice() / 1000, 0, MidpointRounding.AwayFromZero):N0}k PLN";
    private async Task Delete()
    {
        await OnDeleteClickCallback.InvokeAsync(Offer);
    }

    private async Task Buy()
    {
        await OnBuyClickCallback.InvokeAsync(Offer);
    }
}