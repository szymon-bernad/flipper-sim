@page "/"
@using FlipperSim.Components
@using FlipperSim.Services
@using FlipperSimLib
@using FlipperSimLib.Models
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject DialogService DialogService
@inject IStringLocalizer<FlipperSim.Resources.Localization> Localizer
@inject IJSRuntime JS
@inject GameLoopService GameLoop

<PageTitle>@Localizer["AppTitle"]</PageTitle>

@if(IsCultureSet)
{
    @if (GameLoop.IsPaused)
    {
        <PauseOverlay OnResumeClicked="GameLoop.Resume" />
    }
    else
    {
    <RadzenRow>
        <RadzenColumn SizeSM=12 SizeMD="8">
            <RadzenStack AlignItems="AlignItems.Center" Orientation="Radzen.Orientation.Vertical">
                <MarketChart ChartValues="GameLoop.ChartValues" />
                <RadzenRow Gap="0.5rem" class="rz-w-100">
                    <RadzenColumn SizeMD="6" SizeLG="6" SizeSM="12">
                        <AccountPanel AccountBalance="GameLoop.MarketSim.FlipperAccount.AccountBalance"
                                      LoansTotal="GameLoop.LoansTotal"
                                      LoanCapacity="GameLoop.LoanCapacity"
                                      Loans="GameLoop.MarketSim.FlipperAccount.Loans"
                                      OnTakeLoan50k="() => GameLoop.TakeLoan(50_000)"
                                      OnTakeLoan100k="() => GameLoop.TakeLoan(100_000)"
                                      OnPauseAndSave="GameLoop.PauseAndSaveAsync"
                                      OnPayOffLoanCallback="@(EventCallback.Factory.Create<string>(this, (string id) => GameLoop.PayOffLoan(id)))" />
                    </RadzenColumn>
                    <RadzenColumn SizeMD="6" SizeLG="6" SizeSM="12">
                        <InvestmentsPanel Investments="GameLoop.MarketSim.FlipperAccount.Investments"
                                          MarketSim="GameLoop.MarketSim"
                                          OnSellCallback="@(EventCallback.Factory.Create<string>(this, (string id) => GameLoop.SellInvestment(id)))"
                                          OnUpgradeCallback="@(EventCallback.Factory.Create<string>(this, (string id) => GameLoop.UpgradeInvestment(id)))"
                                          OnRentToggleCallback="@(EventCallback.Factory.Create<string>(this, (string id) => GameLoop.ToggleInvestmentRenting(id)))" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn SizeSM="12" SizeMD="4" class="text-end rz-p-3">
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenText TextStyle="TextStyle.H5">@string.Format(Localizer["ActiveOffers"], GameLoop.CurrentOffers.Count)</RadzenText>
                <RadzenRow>
                    @foreach (var off in GameLoop.CurrentOffers)
                    {
                        <RadzenColumn SizeMD="12" SizeLG="6" SizeXL="6">
                            <OfferCard Offer="off" AvailableFunding="GameLoop.MarketSim.FlipperAccount.AccountBalance"
                                       OnDeleteClickCallback="@(EventCallback.Factory.Create<RealEstateOffer>(this, (RealEstateOffer o) => GameLoop.DeleteOffer(o)))"
                                       OnBuyClickCallback="@(EventCallback.Factory.Create<RealEstateOffer>(this, (RealEstateOffer o) => GameLoop.BuyOffer(o)))" />
                        </RadzenColumn>
                    }
                </RadzenRow>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    }
}
else
{
    <LandingPage />
}

@code {

    private bool IsCultureSet = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        GameLoop.OnStateChanged += HandleStateChangedAsync;
        GameLoop.OnGameOver += HandleGameOverAsync;
        GameLoop.OnFreshGame += HandleFreshGameAsync;

        var result = await JS.InvokeAsync<string>("blazorCulture.get");
        IsCultureSet = result is not null;

        if (IsCultureSet)
        {
            await TryLoadSavedGameAsync();
            GameLoop.StartGameLoop();
            StateHasChanged();
        }
    }

    private async Task TryLoadSavedGameAsync()
    {
        if (!await GameLoop.HasSavedGameAsync())
        {
            return;
        }

        var confirmed = await DialogService.Confirm(
            Localizer["LoadSavedGamePrompt"],
            Localizer["SavedGameFound"],
            new ConfirmOptions
            {
                OkButtonText = Localizer["LoadGame"],
                CancelButtonText = Localizer["NewGame"],
            });

        if (confirmed == true)
        {
            await GameLoop.LoadSavedGameAsync();
        }
        else
        {
            await GameLoop.DeleteSavedGameAsync();
        }
    }

    // ── Service event handlers ──

    private async Task HandleStateChangedAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleGameOverAsync(string reason)
    {
        await InvokeAsync(async () =>
        {
            var reasonText = string.IsNullOrEmpty(reason)
                ? Localizer["GameOverDefault"]
                : Localizer[reason];

            await DialogService.Alert(
                reasonText,
                Localizer["GameOver"],
                new AlertOptions { OkButtonText = Localizer["OkThanks"] });
        });
    }

    private async Task HandleFreshGameAsync()
    {
        await DialogService.OpenAsync<WelcomeDialog>(
            Localizer["WelcomeTitle"],
            new Dictionary<string, object>(),
            new DialogOptions()
            {
                Resizable = false,
                Draggable = false,
                CloseDialogOnEsc = false,
                CloseDialogOnOverlayClick = false,
            });
    }

    // ── Cleanup ──

    public void Dispose()
    {
        GameLoop.OnStateChanged -= HandleStateChangedAsync;
        GameLoop.OnGameOver -= HandleGameOverAsync;
        GameLoop.OnFreshGame -= HandleFreshGameAsync;
    }

}
