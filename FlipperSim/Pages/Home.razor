@page "/"
@using FlipperSim.Components
@using FlipperSim.Services
@using FlipperSimLib
@using FlipperSimLib.Models
@using System.Diagnostics
@using Microsoft.Extensions.Localization
@inject DialogService DialogService
@inject IStringLocalizer<FlipperSim.Resources.Localization> Localizer
@inject IJSRuntime JS
@inject GameSaveService GameSaveService

<PageTitle>@Localizer["AppTitle"]</PageTitle>

@if(IsCultureSet)
{
    @if (_isPaused)
    {
        <PauseOverlay OnResumeClicked="ResumeGame" />
    }
    else
    {
    <RadzenRow>
        <RadzenColumn SizeSM=12 SizeMD="8">
            <RadzenStack AlignItems="AlignItems.Center" Orientation="Radzen.Orientation.Vertical">
                <MarketChart ChartValues="_chartValues" />
                <RadzenRow Gap="0.5rem" class="rz-w-100">
                    <RadzenColumn SizeMD="6" SizeLG="6" SizeSM="12">
                        <AccountPanel AccountBalance="MarketSim.FlipperAccount.AccountBalance"
                                      LoansTotal="LoansTotal"
                                      Loans="MarketSim.FlipperAccount.Loans"
                                      OnTakeLoan50k="async () => await TakeLoan(50_000)"
                                      OnTakeLoan100k="async () => await TakeLoan(100_000)"
                                      OnPauseAndSave="PauseAndSaveGame"
                                      OnPayOffLoanCallback="@(EventCallback.Factory.Create<string>(this, PayOffLoan))" />
                    </RadzenColumn>
                    <RadzenColumn SizeMD="6" SizeLG="6" SizeSM="12">
                        <InvestmentsPanel Investments="MarketSim.FlipperAccount.Investments"
                                          MarketSim="MarketSim"
                                          OnSellCallback="@(EventCallback.Factory.Create<string>(this, SellInvestment))"
                                          OnUpgradeCallback="@(EventCallback.Factory.Create<string>(this, UpgradeInvestment))"
                                          OnRentToggleCallback="@(EventCallback.Factory.Create<string>(this, ToggleInvestmentRenting))" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn SizeSM="12" SizeMD="4" class="text-end rz-p-3">
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenText TextStyle="TextStyle.H5">@string.Format(Localizer["ActiveOffers"], CurrentOffers.Count)</RadzenText>
                <RadzenRow>
                    @foreach (var off in CurrentOffers)
                    {
                        <RadzenColumn SizeMD="12" SizeLG="6" SizeXL="6">
                            <OfferCard Offer="off" AvailableFunding="MarketSim.FlipperAccount.AccountBalance"
                                       OnDeleteClickCallback="@(EventCallback.Factory.Create<RealEstateOffer>(this, DeleteOffer))"
                                       OnBuyClickCallback="@(EventCallback.Factory.Create<RealEstateOffer>(this, BuyOffer))" />
                        </RadzenColumn>
                    }
                </RadzenRow>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    }
}
else
{
    <LandingPage />
}

@code {

    private bool IsCultureSet = false;
    private bool _isPaused = false;
    private ICollection<MarketChart.ChartDataItem> _chartValues = new List<MarketChart.ChartDataItem>();
    private readonly MarketPriceProvider _priceProvider = new();
    private RealEstateMarketSimulation MarketSim = default!;
    private ICollection<RealEstateOffer> CurrentOffers = [];
    private decimal LoansTotal => MarketSim.FlipperAccount.Loans.Sum(l => l.LoanAmount);
    private Timer? _refreshTimer = default;
    private long _startIndex = 0;
    private bool _isGameOver = false;
    private string _gameOverReason = string.Empty;
    private readonly Stopwatch _stopWatch = new();

    protected override void OnInitialized()
    {
        MarketSim = new RealEstateMarketSimulation(_priceProvider, null);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var result = await JS.InvokeAsync<string>("blazorCulture.get");
        IsCultureSet = result is not null;
        await InvokeAsync(StateHasChanged);

        if (IsCultureSet)
        {
            await TryLoadSavedGameAsync();

            if (_refreshTimer is null)
            {
                _refreshTimer = new Timer(async s => await RefreshRealEstateMarketAsync(s), null, 0, Timeout.Infinite);
            }

            StateHasChanged();
        }
    }

    private async Task TryLoadSavedGameAsync()
    {
        if (!await GameSaveService.HasSavedGameAsync())
        {
            return;
        }

        var confirmed = await DialogService.Confirm(
            Localizer["LoadSavedGamePrompt"],
            Localizer["SavedGameFound"],
            new ConfirmOptions
            {
                OkButtonText = Localizer["LoadGame"],
                CancelButtonText = Localizer["NewGame"],
            });

        if (confirmed == true)
        {
            var loaded = await GameSaveService.LoadGameAsync(_priceProvider, new SystemRandomProvider(null));
            if (loaded is not null)
            {
                MarketSim = loaded;
            }
        }
        else
        {
            await GameSaveService.DeleteSaveAsync();
        }
    }

    protected async Task RefreshRealEstateMarketAsync(object? state)
    {
        if (_isPaused)
        {
            return;
        }

        _stopWatch.Restart();

        if (_isGameOver)
        {
            MarketSim.ResetAccount();
            await GameSaveService.DeleteSaveAsync();
            var gameOverReasonTxt = string.IsNullOrEmpty(_gameOverReason) ? Localizer["GameOverDefault"] : Localizer[_gameOverReason];

            await DialogService.Alert(gameOverReasonTxt, Localizer["GameOver"], new AlertOptions { OkButtonText = Localizer["OkThanks"] });
            _isGameOver = false;
        }

        if (MarketSim.IsFreshGame)
        {
            await DialogService.OpenAsync<WelcomeDialog>(
                Localizer["WelcomeTitle"],
               new Dictionary<string, object>(),
               new DialogOptions()
               {
                   Resizable = false,
                   Draggable = false,
                   CloseDialogOnEsc = false,
                   CloseDialogOnOverlayClick = false,
               });
        }

        CurrentOffers = MarketSim.GetRealEstateOffersAfterUpdates(10).OrderBy(o => o.CreatedAt).ToList();

        _chartValues.Add(new(_chartValues.LastOrDefault()?.Index+1 ?? 1, (double)MarketSim.GetMarketPricePerSqMeter(50.0m, false)));
        if (_chartValues.Count > 100)
        {
            _chartValues = _chartValues.Skip(1).ToList();
            ++_startIndex;
        }

        (_isGameOver, _gameOverReason) = MarketSim.CheckIfGameIsOver();
        StateHasChanged();
        _stopWatch.Stop();
        var dt = Math.Max(0, 995 - _stopWatch.ElapsedMilliseconds);
        _refreshTimer?.Change(dt, Timeout.Infinite);
    }

    private async Task PauseAndSaveGame()
    {
        _isPaused = true;
        _refreshTimer?.Change(Timeout.Infinite, Timeout.Infinite);

        try
        {
            await GameSaveService.SaveGameAsync(MarketSim);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving game: {ex.Message}");
        }

        StateHasChanged();
    }

    private void ResumeGame()
    {
        _isPaused = false;
        _refreshTimer?.Change(0, Timeout.Infinite);
        StateHasChanged();
    }

    private Task DeleteOffer(RealEstateOffer offer)
    {
        this.MarketSim.DeleteOffer(offer.PropertyRefId);
        this.CurrentOffers.Remove(offer);

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task BuyOffer(RealEstateOffer offer)
    {
        try
        {
            this.MarketSim.BuyOffer(offer.PropertyRefId);
            this.CurrentOffers.Remove(offer);
            StateHasChanged();

        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error buying offer {offer.PropertyRefId}: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    private Task SellInvestment(string refId)
    {
        try
        {
            this.MarketSim.SellInvestment(refId);
            StateHasChanged();
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error selling investment {refId}: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    private Task TakeLoan(decimal amount)
    {
        try
        {
            this.MarketSim.FlipperAccount.AddLoan(
                new Loan
                {
                    InterestRate = this.MarketSim.GetInterestRate(),
                    LoanAmount = amount,
                    PaymentFrequency = 5,
                    LoanId = Guid.NewGuid().ToString()
                });

            StateHasChanged();
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error taking loan of {amount}: {ex.Message}");
        }
        return Task.CompletedTask;

    }

    private Task PayOffLoan(string loanId)
    {
        try
        {
            this.MarketSim.FlipperAccount.PayOffLoan(loanId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error paying off loan: {loanId}: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    private Task UpgradeInvestment(string refId)
    {
        if(this.MarketSim.UpgradeInvestment(refId))
        {
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private Task ToggleInvestmentRenting(string refId)
    {
        if(this.MarketSim.ToggleInvestmentRenting(refId))
        {
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

}
